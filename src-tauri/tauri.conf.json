{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Context Saver",
  "version": "0.1.0",
  "identifier": "com.mb.context-saver",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Context Saver",
        "width": 1200,
        "height": 800,
        "center": true,
        "visible": false,
        "backgroundColor": "#0A0A0B"
      },
      {
        "label": "splashscreen",
        "title": "Context Saver",
        "width": 500,
        "height": 400,
        "center": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "url": "/splashscreen.html",
        "backgroundColor": "#0A0A0B"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}